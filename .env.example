# Copy to .env and fill in. NEVER commit .env or share real values.
PORT=3000
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/pathwise
DATABASE_SSL=false            # set true for most hosted databases

# --- Email (contact form + waitlist are delivered here) ---
CONTACT_TO=s.m.hamza110305@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false             # true only for port 465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-google-app-password
MAIL_FROM=PathWise <your-gmail-address@gmail.com>

# --- AI mentor (optional; offline rule-based mentor is used if unset) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Admin inbox (min 16 chars; generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))") ---
ADMIN_TOKEN=
